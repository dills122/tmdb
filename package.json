  "description": "TMDb SDK.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.0",
    "nock": "^14.0.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/dills122/tmdb#readme",
  "keywords": [
    "tmdb",
    "movie api",
    "movie data",
    "stars",
    "the movie db"
  ],
  "main": "./dist/index.js",
  "name": "@dills1220/tmdb",
  "packageManager": "npm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dills122/tmdb.git"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.js\" eslint.config.mjs && tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run lint && npm test",
    "test": "npm run build && npm run test:types && node --test --test-concurrency=1 test/client.test.js",
    "test:types": "tsc --noEmit -p tsconfig.test.json"
  },
  "type": "commonjs",
  "types": "./dist/index.d.ts",
  "version": "3.0.0"
}
