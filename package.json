{
  "author": {
    "name": "Dylan Steele",
    "email": "dylansteele57@gmail.com"
  },
  "contributors": [
    "Gajus Kuizinas",
    "Dylan Steele"
  ],
  "dependencies": {
    "lodash": "^4.18.1",
    "roarr": "^7.21.7"
  },
  "description": "Typed Node.js SDK for The Movie Database (TMDb) v3 API.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.0",
    "nock": "^14.0.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/dills122/tmdb#readme",
  "keywords": [
    "tmdb",
    "the-movie-database",
    "movie",
    "api",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@dills1220/tmdb",
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dills122/tmdb.git"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.js\" eslint.config.mjs && tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run lint && pnpm test",
    "test": "pnpm run build && pnpm run test:types && node --test --test-concurrency=1 test/client.test.js",
    "test:types": "tsc --noEmit -p tsconfig.test.json"
  },
  "type": "commonjs",
  "types": "./dist/index.d.ts",
  "version": "3.0.0"
}
