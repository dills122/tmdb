{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "module": "Node20",
    "moduleResolution": "Node16",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "useUnknownInCatchVariables": true
  },
  "include": [
    "test/types.test.ts"
  ]
}
